# Copier vers .env (jamais commité)
POSTGRES_USER=lingora
POSTGRES_PASSWORD=lingora
POSTGRES_DB=lingora
DATABASE_URL=postgresql+psycopg://lingora:lingora@db:5432/lingora
JWT_SECRET=dev-only-insecure-secret-change-me-please
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Emails (récupération de mot de passe) ---
# Développement : EMAIL_BACKEND=console écrit le message (avec le lien) dans les logs : docker compose logs backend
EMAIL_BACKEND=console
APP_BASE_URL=http://localhost:3000
# Production : EMAIL_BACKEND=smtp (obligatoire, l'API refuse de démarrer sinon) + serveur SMTP
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# EMAIL_FROM=Lingora <no-reply@votre-domaine.com>
# TRUST_PROXY_HEADERS=true   # uniquement derrière un reverse proxy de confiance (limitation par adresse IP)
